{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Webcore.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "ext-zip": "*",
        "aws/aws-sdk-php": "^3.342",
        "barryvdh/laravel-dompdf": "^2.0.1",
        "doctrine/dbal": "^3.0",
        "google/cloud-storage": "^1.27",
        "guzzlehttp/guzzle": "^7.0.1",
        "illuminate/filesystem": "~5.0|~6.0|~7.0|~8.0|~9.0|~10.0",
        "illuminate/support": "~5.0|~6.0|~7.0|~8.0|~9.0|~10.0",
        "intervention/image": "^2.5",
        "laracasts/flash": "~3.0",
        "laravel/framework": "^10.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^4.0",
        "laravelcollective/html": "^6.1",
        "league/flysystem-aws-s3-v3": "^3.29",
        "league/glide-laravel": "^1.0",
        "maatwebsite/excel": "^3.1",
        "nesbot/carbon": "^2.39",
        "nevadskiy/laravel-tree": "^0.4.0",
        "orangehill/iseed": "^3.0",
        "prettus/l5-repository": "~2.6",
        "spatie/db-dumper": "^3.8",
        "spatie/laravel-permission": "^5.8",
        "spatie/laravel-translatable": "^6.5",
        "unisharp/laravel-filemanager": "^2.6",
        "yajra/laravel-datatables": "^10.0"
    },
    "require-dev": {
        "beyondcode/laravel-dump-server": "^1.5",
        "fzaninotto/faker": "^1.9.1",
        "kitloong/laravel-migrations-generator": "^7.0",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories",
            "packages"
        ],
        "files": [
            "app/Http/Helpers.php",
            "packages/laravel-generator/src/helpers.php"

        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
